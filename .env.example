# Crusoe Managed Inference (OpenAI-compatible). Copy to .env and fill in.
# Confirm the base URL and model IDs in your Crusoe console; these are placeholders.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://managed-inference-api-proxy.crusoecloud.com/v1
AGENT_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# Optional: a larger model for the curator's bug-report dedup fallback
CURATOR_MODEL=
LLM_CONCURRENCY=8
# Reasoning models need room to think before the JSON answer
LLM_MAX_TOKENS=1024
