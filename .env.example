# Crusoe Managed Inference (OpenAI-compatible). Copy to .env and fill in.
# Model IDs are case-sensitive; confirm them with:
#   curl -s https://api.inference.crusoecloud.com/v1/models -H "Authorization: Bearer $CRUSOE_API_KEY" | jq -r '.data[].id'
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Working agents: cheap, high-volume, built for sub-agents
AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Curator's bug-report dedup fallback: larger model
CURATOR_MODEL=nvidia/Nemotron-3-Super-120B-A12B
# Limits are 30 requests/min per model without a payment method on file; keep this low
LLM_CONCURRENCY=4
# Nemotron reasons before answering and that counts against this budget
LLM_MAX_TOKENS=1024
